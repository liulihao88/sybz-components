{
  "compilerOptions": {
    "module": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "preserve",
    "moduleResolution": "nodenext",
    "paths": {
      "@/*": [
        "./packages/*"
      ],
      "@sybz-components/utils": [
        "./packages/utils/src/index.ts"
      ]
    },
    "types": [
      // 用来指定需要包含的模块，并将其包含在全局范围内。
      "element-plus/global",
      "./packages/components.d.ts",
    ]
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.d.ts",
    "packages/**/*.tsx",
    "packages/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
}
