{
  "name": "@sybz-components/utils",
  "version": "1.0.11",
  "description": "utils of sybz-components",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "sybz-code-standard": "./dist/sybz-code-standard.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./gitCommitLog": {
      "types": "./dist/gitCommitLog.d.ts",
      "import": "./dist/gitCommitLog.mjs",
      "require": "./dist/gitCommitLog.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./codeStandard": {
      "types": "./dist/codeStandard.d.ts",
      "import": "./dist/codeStandard.mjs",
      "require": "./dist/codeStandard.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "npx unbuild",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/utils/src",
    "stub": "npx unbuild --stub",
    "releaseOld": "npx unbuild && npm version patch && git add . && git commit -m \"chore: release @sybz-components/utils v$(npm pkg get version | sed 's/\"//g')\" && git push origin && npm publish",
    "release": "node ./scripts/release.mjs"
  },
  "author": "",
  "dependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "8.62.0",
    "@typescript-eslint/parser": "8.62.0",
    "@vue/reactivity": "^3.5.18",
    "@vue/shared": "^3.5.18",
    "code-inspector-plugin": "^0.10.1",
    "consola": "^3.4.2",
    "element-plus": "^2.11.5",
    "eslint": "9.39.4",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-vue": "10.9.2",
    "es-toolkit": "^1.39.10",
    "lodash-es": "^4.17.21",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.8.4",
    "tailwindcss": "^4.3.3",
    "vue": "3.4.15",
    "vue-eslint-parser": "10.4.1"
  },
  "peerDependencies": {
    "vite": ">=5 <8"
  }
}
